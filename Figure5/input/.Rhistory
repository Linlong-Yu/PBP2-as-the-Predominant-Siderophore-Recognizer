data <- read.csv('../input/all_syn_stat_df.csv')
data_with_TonB <- data[data$genome_tonb > 0,]
data_without_TonB <- data[data$genome_tonb = 0,]
data_without_TonB <- data[data$genome_tonb == 0,]
Tonb <- as.data.frame(table(data_with_TonB$tonb_num))
PBP2 <- as.data.frame(table(data_without_TonB$pb_num))
View(PBP2)
View(Tonb)
PBP2_in_pos <-as.data.frame(table(data_with_TonB$pb_num))
View(PBP2_in_pos)
PBP2_in_neg <-as.data.frame(table(data_with_TonB$pb_num))
View(PBP2_in_neg)
View(data_with_TonB)
data_without_TonB_NRPS <- data_without_TonB[data_without_TonB$sid_type == 'NRP',]
PBP2_NRPS_inPOS <- as.data.frame(table(data_without_TonB_NRPS$pb_num))
View(PBP2_NRPS_inPOS)
data <- read.csv('../input/bgc_pfam_matrix.csv')
A = unique(data$Subfolder)
phylogeny_info <- read.csv('../../../gtdb_meta_info/NCBI_all_gtdb_meta_info.csv')
View(phylogeny_info)
B = phylogeny_info$Strain_name
difference <- setdiff(B,A)
difference[1]
difference[100]
difference[1000]
difference[10000]
difference[10005]
difference[1005]
difference$Genus <- phylogeny_info$Genus[difference %in% B]
result <- data.frame(
folder_name = difference,
Genus = phylogeny_info$Genus[match(difference, phylogeny_info$folder_name)]
)
difference <- setdiff(B,A)
result <- data.frame(
folder_name = difference,
Genus = phylogeny_info$Genus[match(difference, phylogeny_info$folder_name)]
)
View(result)
View(phylogeny_info)
View(phylogeny_info)
result <- data.frame(
folder_name = difference,
Genus = phylogeny_info$Genus[match(difference, B)]
)
View(result)
C = as.data.frame(table(result$Genus))
View(C)
hist(C$Freq)
hist(C$Freq,100)
